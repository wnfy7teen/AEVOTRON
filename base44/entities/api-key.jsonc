{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "workspace_id": { "type": "string" },
    "owner_user_id": { "type": "string" },
    "name": { "type": "string" },
    "key_prefix": { "type": "string" },
    "key_hash": {
      "type": "string",
      "description": "HMAC-SHA-256 hash; never store the plaintext API key",
      "rls": { "read": false, "write": false }
    },
    "scopes_json": { "type": "string" },
    "last_used_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["active", "revoked", "expired"],
      "default": "active"
    }
  },
  "required": ["workspace_id", "owner_user_id", "name", "key_prefix", "key_hash", "status"],
  "rls": {
    "create": false,
    "read": { "data.owner_user_id": "{{user.id}}" },
    "update": false,
    "delete": false
  }
}