{
  "name": "WorkspaceMember",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Workspace owner ID; set by trusted backend code"
    },
    "user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["owner", "admin", "member"]
    },
    "status": {
      "type": "string",
      "enum": ["invited", "active", "revoked"]
    }
  },
  "required": ["workspace_id", "owner_user_id", "user_id", "role", "status"],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        { "data.owner_user_id": "{{user.id}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "update": false,
    "delete": false
  }
}