{
  "name": "UsageEvent",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "api_key_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "provider_code": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "input_tokens": {
      "type": "integer"
    },
    "output_tokens": {
      "type": "integer"
    },
    "latency_ms": {
      "type": "integer"
    },
    "status_code": {
      "type": "integer"
    },
    "error_code": {
      "type": "string"
    },
    "estimated_cost": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "owner_user_id",
    "request_id",
    "status_code",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
