{
  "name": "ProviderConnection",
  "type": "object",
  "properties": {
    "workspace_id": { "type": "string" },
    "owner_user_id": { "type": "string" },
    "provider_code": { "type": "string" },
    "display_name": { "type": "string" },
    "credential_ciphertext": {
      "type": "string",
      "description": "Encrypted credential only; never store plaintext provider API keys",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "credential_key_version": {
      "type": "string",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "status": { "type": "string", "enum": ["pending", "active", "error", "revoked"], "default": "pending" },
    "last_tested_at": { "type": "string", "format": "date-time" }
  },
  "required": ["workspace_id", "owner_user_id", "provider_code", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.owner_user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}