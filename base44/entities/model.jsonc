{
  "name": "Model",
  "type": "object",
  "properties": {
    "provider_code": {
      "type": "string"
    },
    "provider_model_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "modality": {
      "type": "string",
      "enum": [
        "chat",
        "image",
        "audio",
        "embedding",
        "video",
        "other"
      ]
    },
    "context_window": {
      "type": "integer"
    },
    "capabilities_json": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "preview",
        "deprecated",
        "disabled"
      ]
    },
    "region_availability_json": {
      "type": "string"
    },
    "pricing_reference": {
      "type": "string"
    }
  },
  "required": [
    "provider_code",
    "provider_model_id",
    "display_name",
    "modality",
    "status"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
