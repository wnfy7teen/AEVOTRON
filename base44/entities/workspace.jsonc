{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Immutable Base44 user ID of the workspace owner",
      "rls": {
        "write": false
      }
    },
    "name": {
      "type": "string",
      "description": "Workspace display name"
    },
    "region": {
      "type": "string",
      "enum": ["global", "eu", "us", "ru"],
      "default": "global"
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended"],
      "default": "active"
    }
  },
  "required": ["owner_user_id", "name", "region", "status"],
  "rls": {
    "create": { "data.owner_user_id": "{{user.id}}" },
    "read": { "data.owner_user_id": "{{user.id}}" },
    "update": { "data.owner_user_id": "{{user.id}}" },
    "delete": { "data.owner_user_id": "{{user.id}}" }
  }
}