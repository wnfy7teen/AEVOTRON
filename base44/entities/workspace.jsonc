{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Immutable Base44 user ID of the workspace owner",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "name": { "type": "string", "description": "Workspace display name" },
    "region": { "type": "string", "enum": ["global", "eu", "us", "ru"], "default": "global" },
    "status": { "type": "string", "enum": ["active", "suspended"], "default": "active" }
  },
  "required": ["owner_user_id", "name", "region", "status"],
  "rls": {
    "create": {
      "$or": [
        { "data.owner_user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.owner_user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.owner_user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.owner_user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}