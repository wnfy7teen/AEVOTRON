# Docker-only configuration. Never commit your real .env file.
# Generate secrets locally:
#   openssl rand -base64 36        (POSTGRES_PASSWORD)
#   openssl rand -base64 32        (AEVOTRON_MASTER_KEY: exactly 32 decoded bytes)
#   openssl rand -hex 32           (IP_HASH_SALT)

POSTGRES_PASSWORD=replace-with-long-random-password
AEVOTRON_MASTER_KEY=replace-with-base64-32-byte-key
IP_HASH_SALT=replace-with-random-hex-salt
PUBLIC_APP_URL=http://localhost:3000
# Keep true behind HTTPS. Set false only for local HTTP development.
COOKIE_SECURE=true

# SMTP is required for production registration and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
