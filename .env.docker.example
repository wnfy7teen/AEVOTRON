# Public Base44 app configuration used by Vite at build time.
# Copy this file to .env and replace the placeholders with values from the
# connected Base44 application. These values are embedded in the public bundle.
VITE_BASE44_APP_ID=replace-with-base44-app-id
VITE_BASE44_FUNCTIONS_VERSION=replace-with-functions-version
VITE_BASE44_APP_BASE_URL=https://replace-with-base44-app-url
